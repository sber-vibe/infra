# Скопируйте в .env и при необходимости поменяйте. Секреты в Git не добавлять.

# Порт стенда на хосте: http://localhost:${HTTP_PORT}
HTTP_PORT=80

# Встраиваются во frontend при сборке образа (после изменения: docker compose build frontend)
NEXT_PUBLIC_AUTO_CLASSIFY=false
NEXT_PUBLIC_CONFIDENCE_THRESHOLD=0.8
# Keycloak: issuer realm и public client (= SUBSIDY_PUBLIC_URL/kc/realms/subsidy). Пусто — демо-вход без Keycloak.
NEXT_PUBLIC_OIDC_ISSUER=http://localhost/kc/realms/subsidy
NEXT_PUBLIC_OIDC_CLIENT_ID=subsidy-frontend

# Публичный адрес стенда (как его видит браузер, без / в конце). От него Keycloak строит issuer и redirect URI.
SUBSIDY_PUBLIC_URL=http://localhost
# Keycloak: администратор (консоль /kc/admin), БД и пароль демо-пользователя specialist.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DEMO_PASSWORD=change-me

# SMTP Яндекса для писем Keycloak (подтверждение почты, восстановление пароля).
# USER — полный адрес ящика, PASSWORD — пароль приложения: id.yandex.ru → Безопасность → Пароли приложений → Почта.
# В настройках Яндекс Почты включите «Почтовые программы» → доступ по IMAP/SMTP.
YANDEX_SMTP_USER=
YANDEX_SMTP_PASSWORD=
